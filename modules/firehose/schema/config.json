{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicas",
    "env_variables"
  ],
  "anyOf": [
    {
      "properties": {
        "env_variables": {
          "required": [
            "SOURCE_KAFKA_BROKERS"
          ]
        }
      }
    },
    {
      "$comment": "brokers may be omitted when the kafka stream is named: they are resolved from the stream's output during plan.",
      "required": [
        "stream_name"
      ]
    },
    {
      "properties": {
        "env_variables": {
          "required": [
            "SOURCE_KAFKA_NAME"
          ]
        }
      }
    }
  ],
  "properties": {
    "stop_time": {
      "type": "string",
      "format": "date-time"
    },
    "replicas": {
      "type": "number",
      "default": 1,
      "minimum": 1
    },
    "deployment_id": {
      "type": "string"
    },
    "team": {
      "type": "string"
    },
    "stream_name": {
      "type": "string"
    },
    "stream_security_enabled": {
      "type": "boolean"
    },
    "service_account": {
      "type": "string"
    },
    "stream_security": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "security_protocol": { "type": "string" },
          "sasl_mechanism": { "type": "string" },
          "ssl_protocol": { "type": "string" },
          "ssl_truststore_type": { "type": "string" },
          "ssl_cert_secret": { "type": "string" },
          "ssl_truststore_password_details": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "secretName": { "type": "string" },
              "key": { "type": "string" }
            }
          },
          "acls": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "secretName": { "type": "string" },
                "usernameKey": { "type": "string" },
                "passwordKey": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "env_variables": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "SINK_TYPE",
        "INPUT_SCHEMA_PROTO_CLASS",
        "SOURCE_KAFKA_TOPIC"
      ],
      "properties": {
        "SOURCE_KAFKA_CONSUMER_GROUP_ID": {
          "type": "string"
        },
        "SOURCE_KAFKA_TOPIC": {
          "type": "string"
        },
        "SOURCE_KAFKA_BROKERS": {
          "type": "string"
        },
        "SINK_TYPE": {
          "type": "string",
          "enum": [
            "JDBC",
            "HTTP",
            "HTTPV2",
            "INFLUXDB",
            "ELASTICSEARCH",
            "GRPC",
            "PROMETHEUS",
            "BLOB",
            "MONGODB",
            "LOG",
            "REDIS",
            "BIGQUERY",
            "BIGTABLE",
            "MAXCOMPUTE"
          ]
        },
        "KAFKA_RECORD_PARSER_MODE": {
          "type": "string",
          "default": "message"
        },
        "INPUT_SCHEMA_PROTO_CLASS": {
          "type": "string"
        }
      }
    },
    "autoscaler": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "type": {
          "type": "string",
          "enum": [
            "keda"
          ]
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "telegraf": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object"
        },
        "config": {
          "type": "object"
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
