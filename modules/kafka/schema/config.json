{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["type", "brokers"],
    "properties": {
        "type": {
            "type": "string"
        }, 
        "advertise_mode": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "host": {
                    "type": "string"
                }, 
                "address": {
                    "type": "string"
                }
            }
        }, 
        "brokers": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "host": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  }
                },
                "required": ["name", "host", "address"]
            }
        },
        "entity": {
            "type": "string"
        },
        "environment": {
            "type": "string"
        },
        "landscape": {
            "type": "string"
        },
        "organization": {
            "type": "string"
        },
        "security": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "security_protocol": {
                    "type": "string"
                },
                "sasl_mechanism": {
                    "type": "string"
                },
                "ssl_protocol": {
                    "type": "string"
                },
                "ssl_truststore_type": {
                    "type": "string"
                },
                "ssl_cert_secret": {
                    "type": "string"
                },
                "ssl_truststore_password_details": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "secretName": {
                            "type": "string"
                        },
                        "key": {
                            "type": "string"
                        }
                    }
                },
                "acls": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "additionalProperties": true,
                        "properties": {
                            "secretName": {
                                "type": "string"
                            },
                            "usernameKey": {
                                "type": "string"
                            },
                            "passwordKey": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}